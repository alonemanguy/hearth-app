# Copy this file to .env.local and fill it in.
#
# Every value here is client-side and ships inside the built JavaScript, so
# none of it is a secret. The Supabase anon key is a public credential by
# design; Row Level Security in the database is what protects each row.
# The service role key must never appear in this project.

# Your Supabase project. Without these the app falls back to Hearth's public
# demo instance in src/lib/supabase.ts.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web push (optional). Generate a key pair with:
#   npx web-push generate-vapid-keys
# Only the public half belongs here. The private half stays on the server that
# sends the notifications.
VITE_VAPID_PUBLIC_KEY=

# Product analytics (optional). Leave blank to send nothing.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
